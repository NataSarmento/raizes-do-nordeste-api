# Copie para .env (ou exporte as variáveis no terminal). Todas têm valor padrão para rodar local.
PORT=8080
DB_URL=jdbc:h2:file:./data/raizes;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
DB_USER=sa
DB_PASSWORD=
JWT_SECRET=troque-esta-chave-em-producao-com-no-minimo-32-caracteres
JWT_EXPIRATION_MINUTES=60

digraph DER { rankdir=LR; fontname="Arial"; node [shape=plaintext, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=9, arrowhead=none];
usuarios [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#DDEBF7"><tr><td bgcolor="#9DC3E6"><b>usuarios</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">email (UK)</td></tr><tr><td align="left">senha_hash</td></tr><tr><td align="left">perfil</td></tr><tr><td align="left">consentimento_lgpd / _em</td></tr><tr><td align="left">consentimento_fidelidade</td></tr></table>>];
unidades [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#DDEBF7"><tr><td bgcolor="#9DC3E6"><b>unidades</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">nome, cidade, ativa</td></tr></table>>];
produtos [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#DDEBF7"><tr><td bgcolor="#9DC3E6"><b>produtos</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">nome, categoria, preco, ativo</td></tr></table>>];
estoques [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#E2F0D9"><tr><td bgcolor="#A9D18E"><b>estoques</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK unidade_id, FK produto_id</td></tr><tr><td align="left">UK(unidade_id, produto_id)</td></tr><tr><td align="left">quantidade CHECK &gt;= 0</td></tr></table>>];
mov_est [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#E2F0D9"><tr><td bgcolor="#A9D18E"><b>movimentos_estoque</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK unidade_id, FK produto_id</td></tr><tr><td align="left">tipo (ENTRADA|SAIDA), quantidade</td></tr><tr><td align="left">pedido_id</td></tr></table>>];
pedidos [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#FFF2CC"><tr><td bgcolor="#FFD966"><b>pedidos</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK cliente_id, FK unidade_id</td></tr><tr><td align="left"><b>canal_pedido</b> (APP|TOTEM|BALCAO|PICKUP|WEB)</td></tr><tr><td align="left">status, subtotal, desconto, total</td></tr><tr><td align="left">idempotency_key (UK)</td></tr></table>>];
itens [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#FFF2CC"><tr><td bgcolor="#FFD966"><b>itens_pedido</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK pedido_id, FK produto_id</td></tr><tr><td align="left">quantidade, preco_unitario</td></tr></table>>];
pagamentos [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#FCE4D6"><tr><td bgcolor="#F4B183"><b>pagamentos</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK pedido_id</td></tr><tr><td align="left">status, valor</td></tr><tr><td align="left">referencia_externa, payload_gateway</td></tr></table>>];
fid [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#EDEDED"><tr><td bgcolor="#BFBFBF"><b>movimentos_fidelidade</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">FK usuario_id</td></tr><tr><td align="left">tipo, pontos, pedido_id</td></tr></table>>];
promo [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#EDEDED"><tr><td bgcolor="#BFBFBF"><b>promocoes</b></td></tr><tr><td align="left">PK id, codigo (UK)</td></tr><tr><td align="left">percentual_desconto, valida_ate</td></tr></table>>];
aud [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="#EDEDED"><tr><td bgcolor="#BFBFBF"><b>auditoria</b></td></tr><tr><td align="left">PK id</td></tr><tr><td align="left">usuario, acao, entidade, entidade_id</td></tr><tr><td align="left">detalhe, criado_em</td></tr></table>>];
usuarios -> pedidos [taillabel="1", headlabel="N"]; unidades -> pedidos [taillabel="1", headlabel="N"];
pedidos -> itens [taillabel="1", headlabel="1..N"]; produtos -> itens [taillabel="1", headlabel="N"];
unidades -> estoques [taillabel="1", headlabel="N"]; produtos -> estoques [taillabel="1", headlabel="N"];
unidades -> mov_est [taillabel="1", headlabel="N"]; produtos -> mov_est [taillabel="1", headlabel="N"];
pedidos -> pagamentos [taillabel="1", headlabel="N"]; usuarios -> fid [taillabel="1", headlabel="N"];
}
